rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isAdmin() { return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && ('roles' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles) && ('administrator' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles || 'platform_admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles || 'super_admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles); }
    match /staffInvites/{inviteId} {
      allow read: if isAuthenticated() && (resource.data.businessOwnerUid == request.auth.uid || resource.data.inviteeEmail == request.auth.token.email);
      allow create: if isAuthenticated() && request.resource.data.businessOwnerUid == request.auth.uid && request.resource.data.status == 'pending' && request.resource.data.role in ['admin','manager','sales','cashier','accountant','inventory','support','delivery','branch_manager','viewer'] && request.resource.data.inviteeEmail is string && request.resource.data.inviteeEmail.size() > 0 && request.resource.data.keys().hasOnly(['businessOwnerUid','inviteeEmail','role','branchName','status','createdAt','invitedAt']);
      allow update: if isAdmin() || (isAuthenticated() && resource.data.inviteeEmail == request.auth.token.email && request.resource.data.businessOwnerUid == resource.data.businessOwnerUid && request.resource.data.inviteeEmail == resource.data.inviteeEmail && request.resource.data.role == resource.data.role && request.resource.data.branchName == resource.data.branchName && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.invitedAt == resource.data.invitedAt && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status in ['accepted','declined']);
      allow delete: if isAuthenticated() && resource.data.businessOwnerUid == request.auth.uid;
    }
  }
}