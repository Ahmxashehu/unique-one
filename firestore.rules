rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    function conversationMemberId(conversationId, uid) { return conversationId + '_' + uid; }
    function isConversationMember(conversationId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/conversationMembers/$(conversationMemberId(conversationId, request.auth.uid)));
    }
    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data != null &&
             'roles' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
             'administrator' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }

    match /educationInstitutions/{institutionId} {
      allow read: if resource.data.status == 'published' || (isAuthenticated() && resource.data.ownerUid == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status in ['draft','published'];
      allow update: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','type','location','description','status','updatedAt'])
        && request.resource.data.status in ['draft','published','suspended']
        || isAdmin();
      allow delete: if isAdmin();
    }
    match /educationCourses/{courseId} {
      allow read: if resource.data.status == 'published' || (isAuthenticated() && resource.data.ownerUid == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.institutionId is string
        && exists(/databases/$(database)/documents/educationInstitutions/$(request.resource.data.institutionId))
        && get(/databases/$(database)/documents/educationInstitutions/$(request.resource.data.institutionId)).data.ownerUid == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.institutionId == resource.data.institutionId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','level','status','updatedAt'])
        && request.resource.data.status in ['draft','published','archived']
        || isAdmin();
      allow delete: if isAdmin();
    }
    match /educationEnrollments/{enrollmentId} {
      allow read: if isAuthenticated() && resource.data.studentUid == request.auth.uid || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.status == 'active';
      allow update: if isAuthenticated()
        && resource.data.studentUid == request.auth.uid
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['programme','level','status','updatedAt'])
        && request.resource.data.status in ['active','completed','withdrawn']
        || isAdmin();
      allow delete: if isAdmin();
    }
    match /educationInstitutions/{institutionId} {
      allow read: if resource.data.status == 'published' || (isAuthenticated() && resource.data.ownerUid == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.status in ['draft','published'];
      allow update: if isAuthenticated() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','type','location','description','status','updatedAt']) && request.resource.data.status in ['draft','published','suspended'] || isAdmin();
      allow delete: if isAdmin();
    }
    match /educationCourses/{courseId} {
      allow read: if resource.data.status == 'published' || (isAuthenticated() && resource.data.ownerUid == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.institutionId is string && exists(/databases/$(database)/documents/educationInstitutions/$(request.resource.data.institutionId)) && get(/databases/$(database)/documents/educationInstitutions/$(request.resource.data.institutionId)).data.ownerUid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.institutionId == resource.data.institutionId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','level','status','updatedAt']) && request.resource.data.status in ['draft','published','archived'] || isAdmin();
      allow delete: if isAdmin();
    }
    match /educationEnrollments/{enrollmentId} {
      allow read: if isAuthenticated() && resource.data.studentUid == request.auth.uid || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.studentUid == request.auth.uid && request.resource.data.status == 'active';
      allow update: if isAuthenticated() && resource.data.studentUid == request.auth.uid && request.resource.data.studentUid == resource.data.studentUid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['programme','level','status','updatedAt']) && request.resource.data.status in ['active','completed','withdrawn'] || isAdmin();
      allow delete: if isAdmin();
    }
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && (!('roles' in request.resource.data) || !('administrator' in request.resource.data.roles));
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles', 'verificationStatus', 'verificationUpdatedAt', 'verificationUpdatedBy', 'uniqueOneId', 'email', 'createdAt', 'status', 'lastLogin', 'permissions', 'hasSecurePin', 'twoFactorEnabled'])) || isAdmin();
      allow delete: if isAdmin();
    }
    match /profiles/{userId} { allow read: if isOwner(userId) || isAdmin(); allow create, update: if isOwner(userId) || isAdmin(); allow delete: if isAdmin(); }
    match /jobs/{jobId} {
      allow read: if resource.data.status == 'published' || (isAuthenticated() && resource.data.employerUid == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.employerUid == request.auth.uid && request.resource.data.status in ['draft','published'];
      allow update: if isAuthenticated() && resource.data.employerUid == request.auth.uid && request.resource.data.employerUid == resource.data.employerUid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','companyName','category','location','employmentType','description','status','updatedAt']) && request.resource.data.status in ['draft','published','closed'];
      allow delete: if isAdmin();
    }
    match /jobApplications/{applicationId} {
      allow read: if isAuthenticated() && (resource.data.applicantUid == request.auth.uid || resource.data.employerUid == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.applicantUid == request.auth.uid && request.resource.data.status == 'submitted';
      allow update: if isAuthenticated() && resource.data.employerUid == request.auth.uid && request.resource.data.applicantUid == resource.data.applicantUid && request.resource.data.jobId == resource.data.jobId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && request.resource.data.status in ['submitted','reviewing','shortlisted','rejected','accepted','withdrawn'];
      allow delete: if isAdmin();
    }
    match /contributionRequests/{requestId} {
      allow read: if isAdmin()
        || resource.data.status == 'published'
        || (isAuthenticated() && resource.data.requesterUid == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.status == 'published'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.category is string
        && request.resource.data.category in ['Household','Community','Education','Agriculture','Health','Business','Emergency','Other']
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 1000;
      allow update: if isAdmin()
        || (isAuthenticated()
          && resource.data.requesterUid == request.auth.uid
          && request.resource.data.requesterUid == resource.data.requesterUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','category','description','status','updatedAt'])
          && request.resource.data.status in ['published','closed','cancelled']);
      allow delete: if isAdmin();
    }
    match /contributionOffers/{offerId} {
      allow read: if isAdmin()
        || (isAuthenticated() && (resource.data.contributorUid == request.auth.uid || resource.data.requesterUid == request.auth.uid));
      allow create: if isAuthenticated()
        && request.resource.data.contributorUid == request.auth.uid
        && request.resource.data.requesterUid is string
        && request.resource.data.requesterUid != request.auth.uid
        && request.resource.data.requestId is string
        && request.resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/contributionRequests/$(request.resource.data.requestId))
        && get(/databases/$(database)/documents/contributionRequests/$(request.resource.data.requestId)).data.requesterUid == request.resource.data.requesterUid
        && get(/databases/$(database)/documents/contributionRequests/$(request.resource.data.requestId)).data.status == 'published';
      allow update: if isAdmin()
        || (isAuthenticated()
          && request.resource.data.contributorUid == resource.data.contributorUid
          && request.resource.data.requesterUid == resource.data.requesterUid
          && request.resource.data.requestId == resource.data.requestId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          && (
            (resource.data.contributorUid == request.auth.uid && request.resource.data.status in ['pending','withdrawn'])
            || (resource.data.requesterUid == request.auth.uid && request.resource.data.status in ['accepted','rejected'])
          ));
      allow delete: if isAdmin();
    }
    match /businesses/{businessId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isAuthenticated()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasNone(['ownerUid', 'status', 'verificationStatus', 'createdAt']));
      allow delete: if isAdmin();
    }
    match /roles/{roleId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /organizations/{orgId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /sessions/{sessionId} { allow read: if isOwner(resource.data.uid) || isAdmin(); allow create, update, delete: if false; }
    match /notifications/{notificationId} { allow read: if isOwner(resource.data.uid); allow update: if isOwner(resource.data.uid) && request.resource.data.uid == resource.data.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']); allow create, delete: if isAdmin(); }
    match /audit_logs/{logId} { allow read: if isAdmin(); allow create, update, delete: if false; }
    // Unique AI audit logs are server-managed through the Firebase Admin SDK. Clients have no access.
    match /aiAuditLogs/{logId} { allow read, create, update, delete: if false; }
    match /products/{productId} {
      allow read: if resource.data.status == 'published' || (isAuthenticated() && resource.data.sellerId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.diff(resource.data).affectedKeys().hasNone(['sellerId', 'createdAt'])
        && request.resource.data.status in ['draft', 'published', 'out_of_stock']
        || isAdmin();
      allow delete: if isAdmin();
    }
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || resource.data.sellerId == request.auth.uid) || isAdmin();
            allow create: if false;
      allow update: if isAuthenticated()
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['draft', 'pending', 'confirmed', 'processing', 'ready_for_pickup', 'shipped', 'out_for_delivery', 'delivered', 'cancelled', 'refunded', 'disputed']
        && (resource.data.customerId == request.auth.uid || resource.data.sellerId == request.auth.uid)
        || isAdmin();
      allow delete: if isAdmin();
    }
    match /productRequests/{requestId} {
      allow read: if resource.data.status == 'published' || (isAuthenticated() && resource.data.customerId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.customerId == request.auth.uid
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['draft', 'pending', 'published', 'cancelled', 'closed']
        || isAdmin();
      allow delete: if isAdmin();
    }
    match /quotes/{quoteId} {
      allow read: if isAdmin() || (isAuthenticated() && (resource.data.sellerId == request.auth.uid || (exists(/databases/$(database)/documents/productRequests/$(resource.data.requestId)) && get(/databases/$(database)/documents/productRequests/$(resource.data.requestId)).data.customerId == request.auth.uid)));
      allow create: if isAuthenticated() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isAuthenticated()
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['pending', 'accepted', 'rejected', 'negotiating']
        || isAdmin();
      allow delete: if isAdmin();
    }
    match /carts/{cartId} { allow read: if isAuthenticated() && resource.data.customerId == request.auth.uid; allow update: if isAuthenticated() && resource.data.customerId == request.auth.uid && request.resource.data.customerId == resource.data.customerId; allow delete: if isAuthenticated() && resource.data.customerId == request.auth.uid; allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid; }
    match /wishlists/{wishlistId} { allow read: if isAuthenticated() && resource.data.customerId == request.auth.uid; allow update: if isAuthenticated() && resource.data.customerId == request.auth.uid && request.resource.data.customerId == resource.data.customerId; allow delete: if isAuthenticated() && resource.data.customerId == request.auth.uid; allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid; }
    match /reviews/{reviewId} { allow read: if true; allow create: if isAuthenticated() && request.resource.data.reviewerId == request.auth.uid && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5 && request.resource.data.targetId is string && request.resource.data.targetType in ['product', 'seller'] && request.resource.data.verifiedPurchase == false; allow update, delete: if isAdmin(); }
    match /payment_requests/{reqId} {
      allow read: if isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated()
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['draft', 'sent', 'viewed', 'pending_approval', 'approved', 'rejected', 'cancelled', 'expired']
        && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid)
        || isAdmin();
      allow delete: if isAdmin();
    }
    match /invoices/{invId} {
      allow read: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || resource.data.customerId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isAuthenticated()
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['draft', 'sent', 'viewed', 'overdue', 'cancelled', 'disputed']
        && (resource.data.sellerId == request.auth.uid || resource.data.customerId == request.auth.uid)
        || isAdmin();
      allow delete: if isAdmin();
    }
    match /receipts/{recId} { allow read: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || resource.data.customerId == request.auth.uid) || isAdmin(); allow create, update, delete: if false; }
    match /transactions/{txId} { allow read: if isAdmin() || (isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid)); allow create, update, delete: if false; }
    match /wallets/{uid} { allow read, create, update, delete: if false; }
    match /walletIdempotency/{idempotencyId} { allow read, create, update, delete: if false; }
    match /ledgerEntries/{ledgerId} { allow read, create, update, delete: if false; }

    match /staffInvites/{inviteId} {
      allow read: if isAuthenticated() && (resource.data.businessOwnerUid == request.auth.uid || resource.data.inviteeEmail == request.auth.token.email);
      allow create: if isAuthenticated() && request.resource.data.businessOwnerUid == request.auth.uid && request.resource.data.status == 'pending' && request.resource.data.role in ['admin','manager','sales','cashier','accountant','inventory','support','delivery','branch_manager','viewer'];
      allow update: if isAdmin() ||
        (isAuthenticated() &&
          resource.data.inviteeEmail == request.auth.token.email &&
          request.resource.data.businessOwnerUid == resource.data.businessOwnerUid &&
          request.resource.data.inviteeEmail == resource.data.inviteeEmail &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.branchName == resource.data.branchName &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.invitedAt == resource.data.invitedAt &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isAuthenticated() && resource.data.businessOwnerUid == request.auth.uid;
    }
    match /staffMembers/{staffId} { allow read: if isAuthenticated() && (resource.data.businessOwnerUid == request.auth.uid || resource.data.uid == request.auth.uid); allow create, update, delete: if false; }
    match /branches/{branchId} {
      allow read: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.businessId is string
        && exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId))
        && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.type in ['headquarters','branch','warehouse','farm_site','storefront']
        && request.resource.data.status == 'active';
      allow update: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','type','address','phone','status','updatedAt'])
        && request.resource.data.type in ['headquarters','branch','warehouse','farm_site','storefront']
        && request.resource.data.status in ['active','inactive'];
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }
    match /suppliers/{supplierId} {
      allow read: if isAuthenticated() && resource.data.businessOwnerUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.businessOwnerUid == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.businessOwnerUid == request.auth.uid
        && request.resource.data.businessOwnerUid == resource.data.businessOwnerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasNone(['businessOwnerUid', 'outstandingAmount', 'verificationStatus', 'createdAt']);
      allow delete: if isAuthenticated() && resource.data.businessOwnerUid == request.auth.uid;
    }

    match /conversations/{conversationId} { allow read: if isConversationMember(conversationId); allow create, update, delete: if false; }
    match /conversationMembers/{memberId} { allow read: if isAuthenticated() && resource.data.uid == request.auth.uid; allow create, update, delete: if false; }
    match /messages/{messageId} { allow read: if isConversationMember(resource.data.conversationId); allow create, update, delete: if false; }
    match /messageDeliveries/{deliveryId} { allow read: if isAuthenticated() && resource.data.uid == request.auth.uid; allow create, update, delete: if false; }
    match /messageRequests/{requestId} { allow read: if isAuthenticated() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid); allow create, update, delete: if false; }
    match /userPresence/{uid} { allow read: if isAuthenticated() && request.auth.uid == uid; allow create, update, delete: if false; }
    match /locations/{locationId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['referenceId', 'lat', 'lng'])
        && request.resource.data.referenceId is string
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.lat >= -90
        && request.resource.data.lat <= 90
        && request.resource.data.lng >= -180
        && request.resource.data.lng <= 180
        && (request.resource.data.referenceId == request.auth.uid
          || (exists(/databases/$(database)/documents/businesses/$(request.resource.data.referenceId))
            && get(/databases/$(database)/documents/businesses/$(request.resource.data.referenceId)).data.ownerUid == request.auth.uid));
      allow update: if isAuthenticated()
        && (resource.data.referenceId == request.auth.uid
          || (exists(/databases/$(database)/documents/businesses/$(resource.data.referenceId))
            && get(/databases/$(database)/documents/businesses/$(resource.data.referenceId)).data.ownerUid == request.auth.uid))
        && request.resource.data.referenceId == resource.data.referenceId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lat', 'lng'])
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.lat >= -90
        && request.resource.data.lat <= 90
        && request.resource.data.lng >= -180
        && request.resource.data.lng <= 180;
      allow delete: if isAdmin();
    }
  }
}
